{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "noEmit": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@superwork/config": ["packages/config/src/index.ts"],
      "@superwork/config/*": ["packages/config/src/*"],
      "@superwork/db": ["packages/db/src/index.ts"],
      "@superwork/db/*": ["packages/db/src/*"],
      "@superwork/core": ["packages/core/src/index.ts"],
      "@superwork/core/*": ["packages/core/src/*"],
      "@superwork/auth": ["packages/auth/src/index.ts"],
      "@superwork/auth/*": ["packages/auth/src/*"],
      "@superwork/ai": ["packages/ai/src/index.ts"],
      "@superwork/ai/*": ["packages/ai/src/*"],
      "@superwork/tools": ["packages/tools/src/index.ts"],
      "@superwork/tools/*": ["packages/tools/src/*"],
      "@superwork/agent": ["packages/agent/src/index.ts"],
      "@superwork/agent/*": ["packages/agent/src/*"],
      "@superwork/integrations": ["packages/integrations/src/index.ts"],
      "@superwork/integrations/*": ["packages/integrations/src/*"],
      "@superwork/ui": ["packages/ui/src/index.ts"],
      "@superwork/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist"]
}
