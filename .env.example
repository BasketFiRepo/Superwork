NODE_ENV=development
DATABASE_URL=postgres://superwork_app:change-me@127.0.0.1:5432/superwork
DATABASE_ADMIN_URL=postgres://postgres:change-me@127.0.0.1:5432/superwork
# The runtime connects as superwork_app and superwork_auth, never as the owner. By default
# those URLs are DATABASE_URL with the username replaced, which assumes all three roles
# share one password. Set these instead when they do not — as on a hosted database, whose
# owner password is issued by the provider. Each must connect as the role it names.
# See docs/deployment.md.
# DATABASE_APP_URL=postgres://superwork_app:change-me@127.0.0.1:5432/superwork
# DATABASE_AUTH_URL=postgres://superwork_auth:change-me@127.0.0.1:5432/superwork
APP_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-change-me-please
AI_MODE=mock
EMAIL_MODE=mock
CALENDAR_MODE=mock
STORAGE_MODE=mock
# Plans and seats (§19). mock holds no card and charges nothing: it answers what a change would
# cost, whether it went through and whether the period renewed, deterministically and locally, and
# every figure from it is badged Simulated. Everything around it — permission, step-up, the seat
# arithmetic, the audit record and what the plan actually stops — is real either way.
BILLING_MODE=mock
# Outbound HTTP for admin-authored tools (§22). mock returns a deterministic local response.
HTTP_TOOLS_MODE=mock
# How often the worker sweeps for due workflow schedules. Schedules are minute-granular.
WORKER_SCHEDULE_MS=60000
AUTOPILOT_ENABLED=false
AGENT_KILL_SWITCH=false
LOG_LEVEL=info
